
(* @NESTEDCOMMENTS := 'Yes' *)
(* @PATH := '\/Modbus' *)
(* @OBJECTFLAGS := '0, 8' *)
(* @SYMFILEFLAGS := '2048' *)
FUNCTION_BLOCK Modbus_FG
VAR CONSTANT
	TempArraySize:BYTE:=10;
	Max_Steps: BYTE :=7;
END_VAR
VAR_INPUT
	xEn: BOOL;
	xStart : BOOL;
	xReset:BOOL;
	strIP:STRING;
	bID:BYTE;
END_VAR
VAR_OUTPUT
	U12:UDINT;
	U13:UDINT;
	U23:UDINT;
	I1:UDINT;
	I2:UDINT;
	I3:UDINT;
	Pa:UDINT;
	Pq:UDINT;
	Eaplus:UDINT;
	Eqplus:UDINT;
	Eaminus:UDINT;
	Eqminus:UDINT;
	freq:INT;
	Open:BOOL;
	Closed:BOOL;
	Tripped:BOOL;

	wErrorCount:WORD;
	xDone:BOOL;
	b_Response_Unit_ID :  BYTE;
END_VAR
VAR
	Odczyt : ETHERNET_MODBUSMASTER_TCP;
	Temp : ARRAY [0..TempArraySize] OF WORD;
	pDint:POINTER TO UDINT;
	Actual_Step:BYTE :=0;
	xReady : BOOL;
	xReadyTrig : R_TRIG;
	xStartNext:BOOL:=0;
	wError : WORD;

	bFUNCTION_CODE: BYTE;
	wREAD_ADDRESS: WORD;
	wREAD_QUANTITY: WORD;
	timeout : TON;
	timeoutTime: TIME:= T#2s;
	delay:TON;
	delayTime:TIME:=T#0ms;
	timeoutEnd:BOOL;

END_VAR
VAR_IN_OUT

END_VAR
(* @END_DECLARATION := '0' *)
IF NOT xEn THEN
	Odczyt(
		xReset:= TRUE,
	);
RETURN;
END_IF
timeout.PT:= timeoutTime;
timeout();

xReadyTrig(CLK := xReady);

IF timeout.Q THEN
	Actual_Step:= Max_Steps;
	wErrorCount := wErrorCount + 1;
	timeout.IN:=FALSE;
	END_IF


CASE Actual_Step OF
0:

	wErrorCount:=0;
	xDone:=FALSE;
	xReset:=FALSE;



	IF xStart AND xReady THEN
	Actual_Step := Next_step(Actual_Step, Max_Steps);
	xStartNext:=TRUE;
	END_IF;


1:	(*U12, U13, U23,  *)

	bFUNCTION_CODE := 4;
	wREAD_ADDRESS:= 20497;
	wREAD_QUANTITY:= 3;
	xStart:= TRUE;
	
	IF NOT timeout.IN THEN
		timeout.IN := TRUE;
	END_IF

	IF xReadyTrig.Q THEN
		delay.IN:= TRUE;
		xStart:= FALSE;
		xReady:= FALSE;
		timeout.IN:=FALSE;
		Actual_Step := Next_step(Actual_Step, Max_Steps);
			IF wError >0 OR bID<>b_Response_Unit_ID THEN
				wErrorCount := wErrorCount + 1;
				Actual_Step:= Max_Steps;
			END_IF
			IF wError = 0 AND bID=b_Response_Unit_ID THEN
				U12 := Temp[0];
				U13 := Temp[1];
				U23 := Temp[2];
			END_IF
	END_IF





2:	(* I1, I2, I3 *)

	bFUNCTION_CODE := 4;
	wREAD_ADDRESS:= 20480;
	wREAD_QUANTITY:= 3;
	xStart:= TRUE;
	
	IF NOT timeout.IN THEN
		timeout.IN := TRUE;
	END_IF

	IF xReadyTrig.Q THEN
		delay.IN:= TRUE;
		xStart:= FALSE;
		xReady:= FALSE;
		timeout.IN:=FALSE;
		Actual_Step := Next_step(Actual_Step, Max_Steps);
			IF wError >0 OR bID<>b_Response_Unit_ID THEN
				wErrorCount := wErrorCount + 1;
				Actual_Step:= Max_Steps;
			END_IF
			IF wError = 0 AND bID=b_Response_Unit_ID THEN
				I1 := Temp[0];
				I2 := Temp[1];
				I3 := Temp[2];
			END_IF
	END_IF



3:	(* Pa, Pq *)

	bFUNCTION_CODE := 4;
	wREAD_ADDRESS:= 20522;
	wREAD_QUANTITY:= 2;
	xStart:= TRUE;
	
	IF NOT timeout.IN THEN
		timeout.IN := TRUE;
	END_IF

	IF xReadyTrig.Q THEN
		delay.IN:= TRUE;
		xStart:= FALSE;
		xReady:= FALSE;
		timeout.IN:=FALSE;
		Actual_Step := Next_step(Actual_Step, Max_Steps);
			IF wError >0 OR bID<>b_Response_Unit_ID THEN
				wErrorCount := wErrorCount + 1;
				Actual_Step:= Max_Steps;
			END_IF
			IF wError = 0 AND bID=b_Response_Unit_ID THEN
				Pa := Temp[0];
				Pq := Temp[1];
			END_IF
	END_IF



4:	(* Ea, Eq *)

	bFUNCTION_CODE := 4;
	wREAD_ADDRESS:= 20532;
	wREAD_QUANTITY:= 10;
	xStart:= TRUE;
	
	IF NOT timeout.IN THEN
		timeout.IN := TRUE;
	END_IF

	IF xReadyTrig.Q THEN
		delay.IN:= TRUE;
		xStart:= FALSE;
		xReady:= FALSE;
		timeout.IN:=FALSE;
		Actual_Step := Next_step(Actual_Step, Max_Steps);
			IF wError >0 OR bID<>b_Response_Unit_ID OR Temp[0]=32768 THEN
				wErrorCount := wErrorCount + 1;
				Actual_Step:= Max_Steps;
			END_IF
			IF wError = 0 AND bID=b_Response_Unit_ID THEN
				Eaplus := UDINT_swap(ADR(Temp[0]));
				Eaminus := UDINT_swap(ADR(Temp[2]));
				Eqplus := UDINT_swap(ADR(Temp[6]));
				Eqminus := UDINT_swap(ADR(Temp[8]));
				IF Eaplus=2147483648 THEN	(*blad wewnetrzny  licznika*)
					wErrorCount := wErrorCount + 1;
					Actual_Step:= Max_Steps;
				END_IF
			END_IF
	END_IF



5:	(* frequency *)

	bFUNCTION_CODE := 4;
	wREAD_ADDRESS:= 20529;
	wREAD_QUANTITY:= 1;
	xStart:= TRUE;
	
	IF NOT timeout.IN THEN
		timeout.IN := TRUE;
	END_IF

	IF xReadyTrig.Q THEN
		delay.IN:= TRUE;
		xStart:= FALSE;
		xReady:= FALSE;
		timeout.IN:=FALSE;
		Actual_Step := Next_step(Actual_Step, Max_Steps);
			IF wError >0 OR bID<>b_Response_Unit_ID THEN
				wErrorCount := wErrorCount + 1;
				Actual_Step:= Max_Steps;
			END_IF
			IF wError = 0 AND bID=b_Response_Unit_ID THEN
				freq:= Temp[0];
			END_IF
	END_IF



6:	(* i1, i2, i3 *)

	bFUNCTION_CODE := 2;
	wREAD_ADDRESS:= 16384;
	wREAD_QUANTITY:= 3;
	xStart:= TRUE;
	
	IF NOT timeout.IN THEN
		timeout.IN := TRUE;
	END_IF

	IF xReadyTrig.Q THEN
		delay.IN:= TRUE;
		xStart:= FALSE;
		xReady:= FALSE;
		timeout.IN:=FALSE;
		Actual_Step := Next_step(Actual_Step, Max_Steps);
			IF wError >0 OR bID<>b_Response_Unit_ID THEN
				wErrorCount := wErrorCount + 1;
				Actual_Step:= Max_Steps;
			END_IF
			IF wError = 0 AND bID=b_Response_Unit_ID THEN
				Open := Temp[0].0;
				Closed := Temp[0].1;
				Tripped := Temp[0].2;
			END_IF
	END_IF



7:
	xStart:= FALSE;
	xReset:=TRUE;
	xDone:=TRUE;
	Actual_Step:= 0;


END_CASE

	Odczyt(
		(*strIP_ADDRESS:= '10.0.0.108',*)
		xStart := xStart,
		strIP_ADDRESS:= strIP,
		wPORT:= 502 ,
		bUNIT_ID:= bID,
		bFUNCTION_CODE:= bFUNCTION_CODE,
		wREAD_ADDRESS:= wREAD_ADDRESS,
		wREAD_QUANTITY:= wREAD_QUANTITY,
		ptREAD_DATA:= ADR(Temp),
		xRESET:= xReset,
		tTIME_OUT:= t#1000ms,
		wERROR=> wError,
		xREADY=> xReady,
		bRESPONSE_UNIT_ID=> b_Response_Unit_ID
	);
END_FUNCTION_BLOCK
