	SW4_RG6_FG3_energia_czynna_pobrana := ModulyDataFG[6].energia_czynna_pobrana;
	SW4_RG6_FG3_energia_czynna_oddana := ModulyDataFG[6].energia_czynna_oddana;
	SW4_RG6_FG3_energia_bierna_pobrana := ModulyDataFG[6].energia_bierna_pobrana;
	SW4_RG6_FG3_energia_bierna_oddana := ModulyDataFG[6].energia_bierna_oddana;
	SW4_RG6_FG3_Open := ModulyDataFG[6].Open;
	SW4_RG6_FG3_Closed := ModulyDataFG[6].Closed;
	SW4_RG6_FG3_Tripped := ModulyDataFG[6].Tripped;
	END_IF

	IF Actual_Step = 7 THEN
	SW4_RG6_FG4_Prad_faza_1 := ModulyDataFG[7].Prad_faza_1;
	SW4_RG6_FG4_Prad_faza_2 := ModulyDataFG[7].Prad_faza_2;
	SW4_RG6_FG4_Prad_faza_3 := ModulyDataFG[7].Prad_faza_3;
