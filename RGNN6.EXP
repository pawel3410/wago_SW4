	SW4_RG6_FG1_energia_bierna_oddana := ModulyDataFG[4].energia_bierna_oddana;
	SW4_RG6_FG1_Open := ModulyDataFG[4].Open;
	SW4_RG6_FG1_Closed := ModulyDataFG[4].Closed;
	SW4_RG6_FG1_Tripped := ModulyDataFG[4].Tripped;
	END_IF

	IF Actual_Step = 5 THEN
	SW4_RG6_FG2_Prad_faza_1 := ModulyDataFG[5].Prad_faza_1;
	SW4_RG6_FG2_Prad_faza_2 := ModulyDataFG[5].Prad_faza_2;
