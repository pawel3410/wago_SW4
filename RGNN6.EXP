	SW4_RG6_FZ3_Tripped := ModulyDataFG[3].Tripped;
	END_IF

	IF Actual_Step = 4 THEN
	SW4_RG6_FG1_Prad_faza_1 := ModulyDataFG[4].Prad_faza_1;
